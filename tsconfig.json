{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "moduleResolution": "node",
    "jsx": "react",
    "jsxFactory": "text",
    "jsxFragmentFactory": "text"
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
